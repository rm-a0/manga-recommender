# APP Settings
APP_ENV=development
APP_DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# DB Settings
# DB_URL needs session-level features - migrations and ingestion both use it.
# Use the direct connection or the session pooler, never the transaction pooler.
# On Azure use the session pooler: the direct host is IPv6-only.
# DB_URL_POOLED is the transaction pooler, used only when DB_USE_POOLED=true.
DB_URL=postgresql://postgres:password@localhost:5432/mydb
DB_URL_POOLED=postgresql://postgres:password@localhost:6543/mydb
DB_USE_POOLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Milliseconds. Unset inherits the server default; 0 explicitly disables it.
# DB_STATEMENT_TIMEOUT=5000

# AniList Settings
ANILIST_REQUESTS_PER_MINUTE=30
ANILIST_MIN_ID=30001
ANILIST_MAX_ID=30201