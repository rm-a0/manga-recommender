APP_ENV=development         # development | production
DEBUG=true                  # set false in production
SECRET_KEY=your-secret-key  # used for JWT signing etc.
API_HOST=0.0.0.0
API_PORT=8000

# Direct connection - use this locally and for migrations
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Transaction pooler - use this in Railway/production (handles connection limits)
DATABASE_URL_POOLED=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

ANILIST_REQUEST_DELAY=0.7    # seconds between pages (~85 req/min, limit is 90)
ANILIST_MAX_PAGES=200        # 200 x 50 = 10 000 items

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
